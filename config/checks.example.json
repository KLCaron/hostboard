{
  "minimumSeverity": "warning",
  "checks": [
    {
      "id": "media",
      "name": "Media server",
      "hostId": "server-a",
      "container": "jellyfin",
      "type": "http",
      "url": "http://127.0.0.1:8096/health",
      "expectedStatuses": [200],
      "expectedContent": "Healthy",
      "intervalSeconds": 60,
      "timeoutMs": 5000,
      "failureThreshold": 3,
      "severity": "critical",
      "cooldownSeconds": 900
    },
    {
      "id": "ssh",
      "name": "SSH listener",
      "hostId": "server-a",
      "type": "tcp",
      "address": "192.168.10.20",
      "port": 22,
      "notify": false
    }
  ]
}
