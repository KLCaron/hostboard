{
  "name": "hostboard",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "test": "tsx --test tests/*.test.ts && python3 -m unittest discover -s tests -p \"test_*.py\"",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit",
    "test:integration": "python3 tests/clean_install.py",
    "test:image-browser": "tsx tests/image-browser.ts",
    "test:reliability-integration": "tsx tests/reliability-integration.ts",
    "test:logs-integration": "python3 tests/log_container.py && tsx tests/log-ssh-integration.ts"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.3",
    "argon2": "^0.45.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "jose": "^6.2.12",
    "memorystore": "^1.6.8",
    "nodemailer": "^10.1.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.19.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "lucide-react": "^1.57.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24 <27"
  }
}
