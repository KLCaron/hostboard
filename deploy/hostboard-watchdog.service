[Unit]
Description=Independent Hostboard and hosting-server availability check
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
User=hostboard-watchdog
EnvironmentFile=/etc/hostboard-watchdog.env
# Optional credential from /etc/credstore/hostboard-smtp.json; missing keeps checks active.
LoadCredential=hostboard-smtp.json
Environment=HOSTBOARD_SMTP_CONFIG=%d/hostboard-smtp.json
ExecStart=/usr/bin/python3 /usr/local/lib/hostboard/watchdog.py
StateDirectory=hostboard-watchdog
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6
TimeoutStartSec=120
