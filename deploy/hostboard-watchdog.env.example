# Use a trusted private origin reachable from the independent monitoring host.
HOSTBOARD_WATCH_URL=http://192.168.10.20:8088
HOSTBOARD_WATCH_HOST=server-a
HOSTBOARD_WATCH_ADDRESS=192.168.10.20
HOSTBOARD_WATCH_BIND=192.168.10.21
HOSTBOARD_WATCH_PORT=8090
HOSTBOARD_WATCH_THRESHOLD=3
HOSTBOARD_WATCH_COOLDOWN=900
# Optional display label; does not change the monitored host ID.
# HOSTBOARD_WATCH_LABEL=Server A / Hostboard availability

# Recommended in both auth modes; REQUIRED with default local authentication.
# Read Agents directly over a private network. No administrator credential or
# Hostboard session is needed. Include the hosting server and other required nodes.
HOSTBOARD_WATCH_AGENTS='[{"url":"http://192.168.10.20:19999","node":"server-a"}]'
# Omitting HOSTBOARD_WATCH_AGENTS keeps legacy /api/fleet supervision, only
# supported at a trusted Cloudflare-mode origin (never the public Access URL).
