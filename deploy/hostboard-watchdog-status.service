[Unit]
Description=Private freshness endpoint for the independent Hostboard watchdog
After=network-online.target hostboard-watchdog.service
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
User=hostboard-watchdog
EnvironmentFile=/etc/hostboard-watchdog.env
ExecStart=/usr/bin/python3 /usr/local/lib/hostboard/watchdog.py --serve
StateDirectory=hostboard-watchdog
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
