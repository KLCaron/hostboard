# Run scripts/setup.sh to create configuration and a random session secret.
# Pin an exact version or ghcr.io/klcaron/hostboard@sha256:... for reproducibility.
HOSTBOARD_IMAGE=ghcr.io/klcaron/hostboard:0.7.0
# Host-side published interface. Loopback is suitable for SSH tunnels/reverse proxies.
HOSTBOARD_BIND=127.0.0.1
HOSTBOARD_PORT=8088
# Must match admin.json origin. Remote local logins require HTTPS.
HOSTBOARD_PUBLIC_URL=http://localhost:8088
# Set by setup for the operator owning bind mounts; use an unprivileged UID.
HOSTBOARD_UID=1000
HOSTBOARD_GID=1000
# Bind mounts persist independently of containers. Run setup as host uid 1000,
# or grant container uid 1000 read access to config/private and ownership of data.
HOSTBOARD_DATA_DIR=./data
HOSTBOARD_PRIVATE_DIR=./private
# Legacy Linux host-network deployment only (deploy/compose.host.yaml):
# HOSTBOARD_TAG=local
